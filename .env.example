# MCP / Tool configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# GitHub personal access token (used by .mcp.json github server)
GITHUB_TOKEN=your_github_pat_here

# OpenCode substitutes these from its launch environment, not this file automatically.
OLLAMA_REMOTE_BASE_URL=http://localhost:11434/v1
OLLAMA_LOCAL_BASE_URL=http://localhost:11434/v1

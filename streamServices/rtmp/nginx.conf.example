worker_processes auto;
rtmp_auto_push on;

events {}

rtmp {
  server {
    listen 1935;
    listen [::]:1935 ipv6only=on;

    application ingest {
      live on;
      record off;

      push rtmp://127.0.0.1:1935/stream;
    }

    application stream {
      live on;
      record off;

      # Enable and replace each destination in the untracked nginx.conf.
      # push rtmp://<RESTREAM_HOST>/live/<RESTREAM_STREAM_KEY>;
      # push rtmp://<SECOND_HOST>/live/<SECOND_STREAM_KEY>;
    }
  }
}

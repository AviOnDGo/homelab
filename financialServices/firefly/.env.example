# You can leave this on "local". If you change it to production most console commands will ask for extra confirmation.
# Never set it to "testing".
APP_ENV=production

# Set to true if you want to see debug information in error screens.
APP_DEBUG=false

# This should be your email address.
SITE_OWNER=mail@example.com

# The encryption key for your sessions. Keep this very secure.
# Generate with: php artisan key:generate
APP_KEY=CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE

# Firefly III will launch using this language (for new users and unauthenticated visitors)
DEFAULT_LANGUAGE=en_US

# The locale defines how numbers are formatted.
DEFAULT_LOCALE=equal

# Change this value to your preferred time zone.
# Example: UTC
TZ=UTC

# TRUSTED_PROXIES is a useful variable when using Docker and/or a reverse proxy.
# Set it to ** and reverse proxies work just fine.
TRUSTED_PROXIES=**

# The log channel defines where your log entries go to.
LOG_CHANNEL=stack

# Log level: debug, info, notice, warning, error, critical, alert, emergency
APP_LOG_LEVEL=notice

# Audit log level.
AUDIT_LOG_LEVEL=emergency
AUDIT_LOG_CHANNEL=

# Used when logging to papertrail:
PAPERTRAIL_HOST=
PAPERTRAIL_PORT=

# Database credentials
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DB_SOCKET=

# MySQL SSL settings
MYSQL_USE_SSL=false
MYSQL_SSL_VERIFY_SERVER_CERT=true
MYSQL_SSL_CAPATH=/etc/ssl/certs/
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=
MYSQL_SSL_CIPHER=

# PostgreSQL SSL settings
PGSQL_SSL_MODE=prefer
PGSQL_SSL_ROOT_CERT=null
PGSQL_SSL_CERT=null
PGSQL_SSL_KEY=null
PGSQL_SSL_CRL_FILE=null
PGSQL_SCHEMA=public

# Cache and session drivers
CACHE_DRIVER=file
SESSION_DRIVER=file

# Redis configuration (if using redis for cache/session)
REDIS_SCHEME=tcp
REDIS_PATH=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB="0"
REDIS_CACHE_DB="1"

# Cookie settings
COOKIE_PATH="/"
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Email settings
MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=2525
MAIL_FROM=changeme@example.com
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_SENDMAIL_COMMAND=

# SMTP settings
MAIL_ALLOW_SELF_SIGNED=false
MAIL_VERIFY_PEER=true
MAIL_VERIFY_PEER_NAME=true

# Other mail drivers
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MANDRILL_SECRET=
SPARKPOST_SECRET=
MAILERSEND_API_KEY=

# Notifications
SEND_ERROR_MESSAGE=true
SEND_REPORT_JOURNALS=true

# External services
ENABLE_EXTERNAL_MAP=false
ENABLE_EXCHANGE_RATES=false
ENABLE_EXTERNAL_RATES=false

# Map defaults
MAP_DEFAULT_LAT=51.983333
MAP_DEFAULT_LONG=5.916667
MAP_DEFAULT_ZOOM=6

# Valid URL protocols
VALID_URL_PROTOCOLS=

# Authentication settings
AUTHENTICATION_GUARD=web
AUTHENTICATION_GUARD_HEADER=REMOTE_USER
AUTHENTICATION_GUARD_EMAIL=

# OAuth settings
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Extra settings
CUSTOM_LOGOUT_URL=
DISABLE_FRAME_HEADER=false
DISABLE_CSP_HEADER=false

# Analytics tracker (Matomo)
TRACKER_SITE_ID=
TRACKER_URL=

# Webhooks
ALLOW_WEBHOOKS=false

# Cron token (32 characters)
STATIC_CRON_TOKEN=

# Docker settings
DKR_BUILD_LOCALE=false
DKR_CHECK_SQLITE=true

# Application defaults
APP_NAME=FireflyIII
BROADCAST_DRIVER=log
QUEUE_DRIVER=sync
CACHE_PREFIX=firefly
PUSHER_KEY=
IPINFO_TOKEN=
PUSHER_SECRET=
PUSHER_ID=
DEMO_USERNAME=
DEMO_PASSWORD=

# Experimental features
USE_RUNNING_BALANCE=false
FIREFLY_III_LAYOUT=v1
QUERY_PARSER_IMPLEMENTATION=legacy

# Your Firefly III external URL
APP_URL=https://your-firefly-domain.com

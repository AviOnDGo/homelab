# Copy this file to .env. Compose passes these values to the app and database.

# Generate a random, stable key of exactly 32 characters.
APP_KEY=REPLACE_WITH_A_STABLE_32_CHARACTER_KEY

# These credentials must match the existing Firefly PostgreSQL role.
DB_USERNAME=firefly
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# Generate a random 32-character token, for example with openssl rand -hex 16.
STATIC_CRON_TOKEN=REPLACE_WITH_A_32_CHARACTER_TOKEN

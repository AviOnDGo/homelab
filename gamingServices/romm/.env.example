# RomM PostgreSQL credentials
DB_NAME=romm
DB_USER=romm
DB_PASSWD=CHANGE_ME_TO_SECURE_PASSWORD
DB_PORT=5432

# RomM authentication signing key — generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32

# Metadata providers — https://docs.romm.app/latest/getting-started/metadata-providers/
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
RETROACHIEVEMENTS_API_KEY=
STEAMGRIDDB_API_KEY=
HASHEOUS_API_ENABLED=false

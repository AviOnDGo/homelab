# select a revision to deploy
AFFINE_REVISION=stable

# internal port for the server container (access via Nginx Proxy Manager)
PORT=3010

# set the host for the server for outgoing links
AFFINE_SERVER_HOST=localhost

# database credentials
DB_USERNAME=affine
DB_PASSWORD=changeme_affine_db_password
DB_DATABASE=affine

# MCP Server configuration [NOTE: Base URL, Email and Password needs to be inside double quotes]
AFFINE_BASE_URL="<>"
AFFINE_EMAIL="<>"
AFFINE_PASSWORD="<>"
AFFINE_MCP_HTTP_TOKEN=<>
# Watchtower environment variables
# Copy this file to .env and fill in your values before deploying.

# Cron expression controlling how often Watchtower checks for image updates.
# Example: run at 3:00 AM every day → "0 0 3 * * *"
# Reference: https://pkg.go.dev/github.com/robfig/cron#hdr-CRON_Expression_Format
WATCHTOWER_SCHEDULE=0 0 3 * * *

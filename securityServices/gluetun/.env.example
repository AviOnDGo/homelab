# Gluetun VPN client environment variables
# Copy this file to .env and fill in your values before deploying.
# Obtain WireGuard credentials from your ProtonVPN account:
#   Account → Downloads → WireGuard configuration → Generate key

# WireGuard private key for this device (from ProtonVPN WireGuard config export)
WIREGUARD_PRIVATE_KEY=your-wireguard-private-key-here

# WireGuard IP address(es) assigned to this device by ProtonVPN (e.g. 10.2.0.2/32)
WIREGUARD_ADDRESSES=10.2.0.2/32

# Comma-separated list of countries to connect to (optional — leave blank for any)
# Example: SERVER_COUNTRIES=Switzerland,Netherlands
SERVER_COUNTRIES=

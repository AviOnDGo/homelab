# ============================================
# Vaultwarden Service Configuration
# ============================================
# Copy this file to .env and fill in your values

# Admin token for accessing the admin panel
# Generate a secure token: openssl rand -base64 32
# Access admin panel at: http://localhost:9010/admin
ADMIN_TOKEN=CHANGE_ME_GENERATE_SECURE_TOKEN

# Allow new user signups
# Set to false to disable new registrations
# REDACTED

# Enable WebSocket notifications for real-time sync
# Required for browser extensions and desktop clients
WEBSOCKET_ENABLED=true

# Pi-hole environment variables
# Copy this file to .env and fill in your values before deploying.

# Password for the Pi-hole web admin interface (FTL web server API).
# Not setting this will result in a random password being generated on startup.
FTLCONF_webserver_api_password=<set-via-env>

# DNS listening mode. Set to 'all' when using Docker's default bridge network.
FTLCONF_dns_listeningMode=all

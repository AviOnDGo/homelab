# Firefox Sync server secrets - copy this file to .env and fill in values
# .env is gitignored; this file is tracked.

# Cryptographic secret for token signing - use a long random string
SYNC_MASTER_SECRET=change_me_use_a_long_random_string

# Shared PostgreSQL password (used by both syncserver and firefoxsync-db)
SYNC_POSTGRES_PASSWORD=change_me_db_password

# Public URL where Firefox clients will reach the sync server
# Must include protocol; no trailing slash
SYNC_TOKENSERVER__INIT_NODE_URL=https://sync.example.com

# Backup Server URI: https://token.services.mozilla.com/1.0/sync/1.5

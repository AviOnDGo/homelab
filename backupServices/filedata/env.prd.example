# ============================================================
# filedata-backup — PRODUCTION environment example
# Copy this file to .env for the production environment.
# Dropbox root: /Apps
# .env is gitignored; this file is tracked.
# ============================================================

# --- Dropbox OAuth2 credentials (required) ---
DROPBOX_AUTH_TOKEN=
DROPBOX_REFRESH_TOKEN=

# --- Google Drive OAuth2 credentials (required for Google Drive sync-crypt mode) ---
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional: set both when these tokens were issued by your own Google OAuth client.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# --- GPG passphrase (for AES256 encryption) ---
GPG_PASSPHRASE=

# --- Discord webhook (optional, leave blank to disable) ---
DISCORD_WEBHOOK_URL=

# --- Shared rclone crypt credentials (used by MEGA and Google Drive crypt remotes) ---
MEGA_USER=
MEGA_PASS=
RCLONE_CRYPT_PASSWORD=
RCLONE_CRYPT_PASSWORD2=

# --- Per-service backup configuration ---

# Pi-hole
PIHOLE_BACKUP_MODE=archive
PIHOLE_DROPBOX_PATH=/Apps/pihole
PIHOLE_SYNC_CRYPT_REMOTE=
PIHOLE_RETENTION_DAYS=61
PIHOLE_CRON_SCHEDULE=0 2 */10 * *

# Nginx Proxy Manager
NPM_BACKUP_MODE=archive
NPM_DROPBOX_PATH=/Apps/npm
NPM_SYNC_CRYPT_REMOTE=
NPM_RETENTION_DAYS=57
NPM_CRON_SCHEDULE=10 2 */7 * *

# Vaultwarden
VAULTWARDEN_BACKUP_MODE=archive
VAULTWARDEN_DROPBOX_PATH=/Apps/vaultwarden
VAULTWARDEN_SYNC_CRYPT_REMOTE=
VAULTWARDEN_RETENTION_DAYS=7
VAULTWARDEN_CRON_SCHEDULE=15 2 * * *

# Hermes
HERMES_BACKUP_MODE=archive
HERMES_DROPBOX_PATH=/Apps/hermes
HERMES_SYNC_CRYPT_REMOTE=
HERMES_RETENTION_DAYS=14
HERMES_CRON_SCHEDULE=35 2 * * *

# n8n
N8N_BACKUP_MODE=archive
N8N_DROPBOX_PATH=/Apps/n8n
N8N_SYNC_CRYPT_REMOTE=
N8N_RETENTION_DAYS=30
N8N_CRON_SCHEDULE=25 2 * * *

# OmniRoute (contains provider credentials; backup artifacts are GPG-encrypted)
OMNIROUTE_BACKUP_MODE=archive
OMNIROUTE_DROPBOX_PATH=/Apps/omniroute
OMNIROUTE_SYNC_CRYPT_REMOTE=
OMNIROUTE_RETENTION_DAYS=14
OMNIROUTE_CRON_SCHEDULE=30 2 * * *

# Open WebUI
OPENWEBUI_BACKUP_MODE=archive
OPENWEBUI_DROPBOX_PATH=/Apps/openwebui
OPENWEBUI_SYNC_CRYPT_REMOTE=
OPENWEBUI_RETENTION_DAYS=14
OPENWEBUI_CRON_SCHEDULE=20 2 * * *

# AFFiNE
AFFINE_BACKUP_MODE=archive
AFFINE_DROPBOX_PATH=/Apps/affine
AFFINE_SYNC_CRYPT_REMOTE=
AFFINE_RETENTION_DAYS=30
AFFINE_CRON_SCHEDULE=25 2 * * *

# FreshRSS
FRESHRSS_BACKUP_MODE=archive
FRESHRSS_DROPBOX_PATH=/Apps/freshrss
FRESHRSS_SYNC_CRYPT_REMOTE=
FRESHRSS_RETENTION_DAYS=7
FRESHRSS_CRON_SCHEDULE=0 4 * * *

# Jellyfin configuration only
JELLYFIN_BACKUP_MODE=archive
JELLYFIN_DROPBOX_PATH=/App_acc/jellyfin
JELLYFIN_SYNC_CRYPT_REMOTE=
JELLYFIN_RETENTION_DAYS=7
JELLYFIN_CRON_SCHEDULE=0 4 * * *

# Immich — photo library (sync-crypt lane)
IMMICH_LIBRARY_BACKUP_MODE=sync-crypt
IMMICH_LIBRARY_DROPBOX_PATH=
IMMICH_LIBRARY_SYNC_CRYPT_REMOTE=mega-crypt:/Apps/immich-library
IMMICH_LIBRARY_RETENTION_DAYS=30
IMMICH_LIBRARY_CRON_SCHEDULE=0 3 * * *

# Immich — user profiles (sync-crypt lane)
IMMICH_PROFILE_BACKUP_MODE=sync-crypt
IMMICH_PROFILE_DROPBOX_PATH=
IMMICH_PROFILE_SYNC_CRYPT_REMOTE=mega-crypt:/Apps/immich-profile
IMMICH_PROFILE_RETENTION_DAYS=30
IMMICH_PROFILE_CRON_SCHEDULE=15 3 * * *

# Immich — raw uploads (sync-crypt lane)
IMMICH_UPLOAD_BACKUP_MODE=sync-crypt
IMMICH_UPLOAD_DROPBOX_PATH=
IMMICH_UPLOAD_SYNC_CRYPT_REMOTE=mega-crypt:/Apps/immich-upload
IMMICH_UPLOAD_RETENTION_DAYS=30
IMMICH_UPLOAD_CRON_SCHEDULE=30 3 * * *

# Kasm
KASM_BACKUP_MODE=archive
KASM_DROPBOX_PATH=/Apps/kasm
KASM_SYNC_CRYPT_REMOTE=
KASM_RETENTION_DAYS=7
KASM_CRON_SCHEDULE=5 4 * * *

# Firefox
FIREFOX_BACKUP_MODE=archive
FIREFOX_DROPBOX_PATH=/Apps/firefox
FIREFOX_SYNC_CRYPT_REMOTE=
FIREFOX_RETENTION_DAYS=14
FIREFOX_CRON_SCHEDULE=10 4 * * *

# Syncthing config
SYNCTHING_BACKUP_MODE=archive
SYNCTHING_DROPBOX_PATH=/Apps/syncthing
SYNCTHING_SYNC_CRYPT_REMOTE=
SYNCTHING_RETENTION_DAYS=7
SYNCTHING_CRON_SCHEDULE=15 1 * * *

# Paperless (Knowledge Services) — pure encrypted mirror (excludes thumbnails and media.lock)
PAPERLESS_BACKUP_MODE=sync-crypt
PAPERLESS_DROPBOX_PATH=
PAPERLESS_SYNC_CRYPT_REMOTE=gdrive-crypt:paperless
PAPERLESS_RETENTION_DAYS=0
PAPERLESS_CRON_SCHEDULE=15 4 * * *

# Jackett configuration
JACKETT_BACKUP_MODE=archive
JACKETT_DROPBOX_PATH=/Apps/jackett
JACKETT_SYNC_CRYPT_REMOTE=
JACKETT_RETENTION_DAYS=7
JACKETT_CRON_SCHEDULE=30 4 * * *

# Radarr configuration
RADARR_BACKUP_MODE=archive
RADARR_DROPBOX_PATH=/Apps/radarr
RADARR_SYNC_CRYPT_REMOTE=
RADARR_RETENTION_DAYS=2
RADARR_CRON_SCHEDULE=20 4 * * *

# Sonarr configuration
SONARR_BACKUP_MODE=archive
SONARR_DROPBOX_PATH=/Apps/sonarr
SONARR_SYNC_CRYPT_REMOTE=
SONARR_RETENTION_DAYS=2
SONARR_CRON_SCHEDULE=25 4 * * *

# Transmission configuration
TRANSMISSION_BACKUP_MODE=archive
TRANSMISSION_DROPBOX_PATH=/Apps/transmission
TRANSMISSION_SYNC_CRYPT_REMOTE=
TRANSMISSION_RETENTION_DAYS=7
TRANSMISSION_CRON_SCHEDULE=35 4 * * *

# Radicale
RADICALE_BACKUP_MODE=archive
RADICALE_DROPBOX_PATH=/Apps/radicale
RADICALE_SYNC_CRYPT_REMOTE=
RADICALE_RETENTION_DAYS=7
RADICALE_CRON_SCHEDULE=0 3 * * *

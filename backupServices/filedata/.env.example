# Copy this file to .env and configure only the credentials needed by this host.
# Destination paths are configured separately in path.local and path.prod.

# Dropbox OAuth2
DROPBOX_AUTH_TOKEN=
DROPBOX_REFRESH_TOKEN=

# Google Drive OAuth2 (set both client fields when using your own OAuth client)
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Archive encryption and optional failure notifications
GPG_PASSPHRASE=
DISCORD_WEBHOOK_URL=

# MEGA and shared rclone crypt credentials
MEGA_USER=
MEGA_PASS=
RCLONE_CRYPT_PASSWORD=
RCLONE_CRYPT_PASSWORD2=

# Filen credentials
FILEN_EMAIL=
FILEN_PASSWORD=
FILEN_API_KEY=

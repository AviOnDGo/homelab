# ============================================================
# db-backup — PRODUCTION environment example
# Copy this file to .env for the production environment.
# Dropbox root: /Apps
# .env is gitignored; this file is tracked.
# Cron schedules and retention are configured in backup-databases.conf.
# ============================================================

# --- PostgreSQL credentials ---

# Invidious
INVIDIOUS_DB_HOST=invidious-db
INVIDIOUS_DB_NAME=invidious
INVIDIOUS_DB_USER=kemal
INVIDIOUS_DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
INVIDIOUS_BACKUP_NAME=invidious
INVIDIOUS_DROPBOX_BACKUP_PATH=/Apps/invidious

# Firefly
FIREFLY_DB_HOST=firefly-db
FIREFLY_DB_NAME=firefly
FIREFLY_DB_USER=firefly
FIREFLY_DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
FIREFLY_BACKUP_NAME=firefly
FIREFLY_DROPBOX_BACKUP_PATH=/Apps/firefly

# Paperless (Knowledge Services)
PAPERLESS_DB_HOST=paperless-db
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
PAPERLESS_DB_NAME=paperless
PAPERLESS_BACKUP_NAME=paperless
PAPERLESS_DROPBOX_BACKUP_PATH=/Apps/paperless

# Immich
IMMICH_DB_HOST=immich-db
IMMICH_DB_NAME=immich
IMMICH_DB_USER=postgres
IMMICH_DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
IMMICH_BACKUP_NAME=immich
IMMICH_DROPBOX_BACKUP_PATH=/Apps/immich

# Firefox Sync
FIREFOXSYNC_DB_HOST=firefoxsync-db
FIREFOXSYNC_DB_NAME=firefoxsync
FIREFOXSYNC_DB_USER=sync
FIREFOXSYNC_DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
FIREFOXSYNC_BACKUP_NAME=firefoxsync
FIREFOXSYNC_DROPBOX_BACKUP_PATH=/Apps/firefoxsync

# RomM
ROMM_DB_HOST=romm-db
ROMM_DB_NAME=romm
ROMM_DB_USER=romm
ROMM_DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
ROMM_BACKUP_NAME=romm
ROMM_DROPBOX_BACKUP_PATH=/Apps/romm

# --- Dropbox OAuth2 credentials (required) ---
DROPBOX_AUTH_TOKEN=
DROPBOX_REFRESH_TOKEN=

# --- GPG passphrase (for AES256 encryption) ---
GPG_PASSPHRASE=

# --- Discord webhook (optional, leave blank to disable) ---
DISCORD_WEBHOOK_URL=
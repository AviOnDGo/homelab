# Required: replace these with values for your GCP project and billing account.
project_id           = "your-gcp-project-id"
billing_account_id   = "XXXXXX-XXXXXX-XXXXXX"
budget_currency_code = "USD" # Replace with your billing account's currency code.

# Optional: defaults shown below.
region = "us-central1"
zone   = "us-central1-a"

# Optional: leave empty to use the default Compute Engine service account.
vm_service_account_email = ""

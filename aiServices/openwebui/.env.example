# =============================================================================
# Open WebUI — Environment Configuration
# Copy this file to .env and adjust values before running docker compose up -d
# =============================================================================

# ----------------------------------------------------------------------------
# Ollama Backend
# ----------------------------------------------------------------------------
# URL of the Ollama API, resolved via the shared ai_network.
# Change only if Ollama is running on a different container name or host.
OLLAMA_BASE_URL=http://ollama:11434

# Public HTTPS origin configured in Nginx Proxy Manager; no trailing slash.
CORS_ALLOW_ORIGIN=https://openwebui.example.com

# Include any host-specific Ollama or agent addresses that must bypass Gluetun.
# Keep both container names and loopback addresses when customizing this list.
WEBUI_NO_PROXY=localhost,127.0.0.1,ollama,openwebui,opencode,hermes

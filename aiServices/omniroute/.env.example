# =============================================================================
# OmniRoute — Environment Configuration
# Copy this file to .env before starting the service.
# =============================================================================

# REQUIRE_API_KEY=true and ALLOW_API_KEY_REVEAL=false are enforced in
# docker-compose.yml. Provider API keys are managed in OmniRoute's dashboard.

# Optional stable secrets. If omitted, OmniRoute generates these on first
# startup and persists them in omniroute_filedata.
# Generate with:
#   openssl rand -base64 48  # JWT_SECRET
#   openssl rand -hex 32     # API_KEY_SECRET
# Set the generated values below before first startup if you want to manage
# these secrets outside the data volume.
# JWT_SECRET=
# API_KEY_SECRET=

# When using an HTTPS reverse proxy, set the public URL and enable secure
# cookies. Do not enable AUTH_COOKIE_SECURE when accessing over plain HTTP.
# BASE_URL is used for internal server-to-server requests.
BASE_URL=http://omniroute:20128
# NEXT_PUBLIC_BASE_URL=https://omniroute.example.com
# AUTH_COOKIE_SECURE=true

# Route upstream provider traffic through Gluetun's HTTP proxy.
# Keep local dashboard, healthcheck, and Ollama traffic off the proxy.
HTTP_PROXY=http://gluetun:8888
HTTPS_PROXY=http://gluetun:8888
NO_PROXY=localhost,127.0.0.1,omniroute,ollama
# Do not fall back to direct egress if the configured proxy is unavailable.
PROXY_FAIL_OPEN=false

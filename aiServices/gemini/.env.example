# Set this to a Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key

# Absolute host path to the same Obsidian vault mounted in your OpenCode setup.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian/vault

# Match the host user so Gemini can edit files in the mounted workspace.
GEMINI_UID=1000
GEMINI_GID=1000

# =============================================================================
# Ollama — Environment Configuration
# Copy this file to .env and adjust values before running docker compose up -d
# =============================================================================

# ----------------------------------------------------------------------------
# GPU Acceleration
# ----------------------------------------------------------------------------
# GPU is disabled by default (CPU-only inference).
# To enable GPU acceleration, uncomment the relevant device block in
# docker-compose.yml (NVIDIA or AMD ROCm) and restart the container.
# See SERVICE_DOCUMENTATION.md for step-by-step GPU setup instructions.

# ----------------------------------------------------------------------------
# Optional Resource Limits (disabled by default)
# ----------------------------------------------------------------------------
# Uncomment `mem_limit` and `cpus` in docker-compose.yml to enable these.
# Keep these values here so limits can be enabled quickly when needed.
# Memory cap for the Ollama container when limits are enabled.
OLLAMA_MEMORY_LIMIT=4g

# CPU cap for the Ollama container when limits are enabled.
# Example values: 1.0, 2.0, 4.0
OLLAMA_CPU_LIMIT=2.0

# ----------------------------------------------------------------------------
# Performance Tuning
# ----------------------------------------------------------------------------
# Maximum number of concurrent inference requests processed simultaneously.
# Setting this to 1 minimises memory pressure on low-RAM hosts (≤8 GB).
OLLAMA_NUM_PARALLEL=1

# Maximum number of models that can be resident in memory at the same time.
# Keep at 1 on a 7.1 GB host to prevent OOM when llama3.2:3b is loaded.
OLLAMA_MAX_LOADED_MODELS=1

# How long a loaded model is kept in memory after the last inference request.
# 15m balances cold-start latency with memory frugality on a low-RAM host.
# Set to 0 to unload immediately after each request.
OLLAMA_KEEP_ALIVE=15m
